{
  "$schema": "https://github.com/Azure/data-api-builder/releases/download/v2.0.12/dab.draft.schema.json",
  "data-source": {
    "database-type": "mssql",
    "connection-string": "@env('AZURE_SQL_CONN')"
  },
  "runtime": {
    "rest": {
      "enabled": true,
      "path": "/api",
      "request-body-strict": false
    },
    "graphql": {
      "enabled": true,
      "path": "/graphql",
      "allow-introspection": true
    },
    "mcp": {
      "enabled": true,
      "path": "/mcp"
    },
    "host": {
      "cors": {
        "origins": [],
        "allow-credentials": false
      },
      "authentication": {
        "provider": "Unauthenticated"
      },
      "mode": "development"
    },
    "telemetry": {
      "open-telemetry": {
        "enabled": true,
        "endpoint": "@env('OTEL_EXPORTER_OTLP_ENDPOINT')",
        "headers": "@env('OTEL_EXPORTER_OTLP_HEADERS')",
        "service-name": "@env('OTEL_SERVICE_NAME')"
      }
    },
    "cache": {
      "enabled": true,
      "ttl-seconds": 30
    },
    "health": {
      "enabled": true,
      "roles": []
    }
  },
  "autoentities": {},
  "entities": {
    "Policy": {
      "description": "Insurance policies. Brokers see only their own rows.",
      "source": {
        "object": "dbo.Policies",
        "type": "table"
      },
      "fields": [],
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "Policy",
          "plural": "Policies"
        }
      },
      "rest": {
        "enabled": true
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "*"
            }
          ]
        }
      ],
      "cache": {
        "enabled": true,
        "ttl-seconds": 30,
        "level": "L1"
      }
    },
    "Broker": {
      "source": {
        "object": "dbo.Brokers",
        "type": "table"
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "Broker",
          "plural": "Brokers"
        }
      },
      "rest": {
        "enabled": true
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "*"
            }
          ]
        }
      ]
    },
    "Claim": {
      "description": "Claims opened against a policy",
      "source": {
        "object": "dbo.Claims",
        "type": "table"
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "Claim",
          "plural": "Claims"
        }
      },
      "rest": {
        "enabled": true
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "*"
            }
          ]
        }
      ]
    }
  }
}