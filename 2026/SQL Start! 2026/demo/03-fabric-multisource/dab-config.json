{
  "$schema": "https://github.com/Azure/data-api-builder/releases/latest/download/dab.draft.schema.json",
  "data-source": {
    "database-type": "mssql",
    "connection-string": "@env('SQL_CONN')",
    "health": {
      "name": "onprem-insurance"
    }
  },
  "data-source-files": [
    "dab-config.azuresql.json",
    "dab-config.fabric.json"
  ],
  "runtime": {
    "rest": {
      "enabled": true,
      "path": "/api"
    },
    "graphql": {
      "enabled": true,
      "path": "/graphql"
    },
    "mcp": {
      "enabled": true,
      "description": "Hybrid insurance API: policies and brokers on-premises, claims in Azure SQL, sales facts in Microsoft Fabric."
    },
    "host": {
      "mode": "development",
      "authentication": {
        "provider": "Unauthenticated"
      }
    }
  },
  "entities": {
    "Policy": {
      "source": { "object": "dbo.Policies", "type": "table" },
      "description": "Insurance policies — system of record, on-premises SQL Server",
      "rest": { "path": "policies" },
      "permissions": [ { "role": "anonymous", "actions": [ "read" ] } ]
    },
    "Broker": {
      "source": { "object": "dbo.Brokers", "type": "table" },
      "description": "Brokers — on-premises SQL Server",
      "rest": { "path": "brokers" },
      "permissions": [ { "role": "anonymous", "actions": [ "read" ] } ]
    }
  }
}
