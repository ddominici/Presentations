{
  "$schema": "https://github.com/Azure/data-api-builder/releases/download/v2.0.12/dab.draft.schema.json",
  "data-source": {
    "database-type": "postgresql",
    "connection-string": "@env('PG_CONN')",
    "options": {}
  },
  "runtime": {
    "rest": {
      "enabled": true,
      "path": "/api",
      "request-body-strict": false
    },
    "graphql": {
      "enabled": true,
      "path": "/graphql",
      "allow-introspection": true
    },
    "mcp": {
      "enabled": true,
      "path": "/mcp"
    },
    "host": {
      "cors": {
        "origins": [],
        "allow-credentials": false
      },
      "authentication": {
        "provider": "Unauthenticated"
      },
      "mode": "development"
    },
    "telemetry": {
      "open-telemetry": {
        "enabled": true,
        "endpoint": "@env('OTEL_EXPORTER_OTLP_ENDPOINT')",
        "headers": "@env('OTEL_EXPORTER_OTLP_HEADERS')",
        "service-name": "@env('OTEL_SERVICE_NAME')"
      }
    }
  },
  "autoentities": {},
  "entities": {
    "Policy": {
      "description": "Insurance policies, one row per contract",
      "source": {
        "object": "public.policies",
        "type": "table"
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "Policy",
          "plural": "Policies"
        }
      },
      "rest": {
        "enabled": true
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "*"
            }
          ]
        }
      ]
    },
    "Broker": {
      "description": "Brokers who sell the policies",
      "source": {
        "object": "public.brokers",
        "type": "table"
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "Broker",
          "plural": "Brokers"
        }
      },
      "rest": {
        "enabled": true
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    },
    "PolicySummary": {
      "description": "Denormalised policy and broker summary",
      "source": {
        "object": "public.vw_policysummary",
        "type": "view",
        "key-fields": [
          "policy_id"
        ]
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "PolicySummary",
          "plural": "PolicySummaries"
        }
      },
      "rest": {
        "enabled": true
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    }
  }
}