#!/usr/bin/env bash
# Copy to env.sh (git-ignored) and fill in.
export RG="msdocs-dab-aci"
export LOCATION="westeurope"
export ACR="dabdemo$RANDOM"          # must be globally unique
export ACI_NAME="dab-session"
export DNS_LABEL="dab-session-$RANDOM"
export IMAGE_TAG="dab:2"

# Demo shortcut: the connection string as an environment variable.
# In production use a managed identity, or @akv() against Key Vault.
export CONN="Server=tcp:<server>.database.windows.net,1433;Database=InsuranceDemo;User ID=<user>;Password=<password>;Encrypt=true;"
