# Copy to .env and fill in. Never commit .env.

# --- demo 1: local SQL Server in Docker -------------------------------------
MSSQL_SA_PASSWORD=Str0ng!Passw0rd
SQL_CONN="Server=localhost,1433;Database=InsuranceDemo;User ID=sa;Password=Str0ng!Passw0rd;TrustServerCertificate=true;Encrypt=false"

# --- demo 2: Azure SQL ------------------------------------------------------
# Managed identity (preferred when DAB runs in Azure):
#   Server=tcp:<server>.database.windows.net,1433;Database=InsuranceDemo;Authentication=Active Directory Managed Identity;
# Service principal / interactive for a laptop demo:
#AZURE_SQL_CONN="Server=tcp:<server>.database.windows.net,1433;Database=InsuranceDemo;Authentication=Active Directory Default;Encrypt=true;"
# Username / Password
AZURE_SQL_CONN="Server=tcp:<server>.database.windows.net,1433;Database=insurancedemo;User ID=sqlcon;Password=<your-password>;Encrypt=true;"

# Entra ID application used to validate incoming tokens
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_AUDIENCE=api://dab-demo

# --- demo 3: SQL database in Microsoft Fabric --------------------------------
# Fabric SQL accepts Microsoft Entra authentication only — no SQL logins.
FABRIC_CONN="Server=<workspace>.database.fabric.microsoft.com,1433;Database=SalesDemo;Authentication=Active Directory Default;Encrypt=true;"

# Fabric Warehouse / Lakehouse SQL endpoint instead of a Fabric SQL database:
#   database-type must be "dwsql", and the server name carries no tcp: prefix
# FABRIC_DW_CONN=Server=<workspace>.datawarehouse.fabric.microsoft.com;Initial Catalog=SalesDW;Authentication=Active Directory Default;Encrypt=True;

# --- demo 4: deployment ------------------------------------------------------
AZURE_RG=msdocs-dab-aci
AZURE_LOCATION=westeurope
ACR_NAME=dabdemo0000
