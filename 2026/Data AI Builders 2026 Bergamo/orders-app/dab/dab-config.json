{
  "$schema": "https://github.com/Azure/data-api-builder/releases/download/v2.0.12/dab.draft.schema.json",
  "data-source": {
    "database-type": "postgresql",
    "connection-string": "@env('DAB_CONNECTION')",
    "options": {}
  },
  "runtime": {
    "rest": {
      "enabled": true,
      "path": "/api",
      "request-body-strict": false
    },
    "graphql": {
      "enabled": true,
      "path": "/graphql",
      "allow-introspection": true
    },
    "mcp": {
      "enabled": false
    },
    "host": {
      "cors": {
        "origins": [
          "http://localhost:5173",
          "http://localhost:4173"
        ],
        "allow-credentials": false
      },
      "authentication": {
        "provider": "Unauthenticated"
      },
      "mode": "development"
    }
  },
  "entities": {
    "Customer": {
      "source": {
        "object": "shop.customers",
        "type": "table"
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "customer",
          "plural": "customers"
        }
      },
      "rest": {
        "enabled": true,
        "path": "/customers"
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "create"
            },
            {
              "action": "read"
            },
            {
              "action": "update"
            }
          ]
        }
      ]
    },
    "Order": {
      "source": {
        "object": "shop.orders",
        "type": "table"
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "order",
          "plural": "orders"
        }
      },
      "rest": {
        "enabled": true,
        "path": "/orders"
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            },
            {
              "action": "update"
            },
            {
              "action": "delete"
            }
          ]
        }
      ]
    },
    "OrderEvent": {
      "source": {
        "object": "shop.order_events",
        "type": "table"
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "orderEvent",
          "plural": "orderEvents"
        }
      },
      "rest": {
        "enabled": true,
        "path": "/order-events"
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    },
    "OrderOverview": {
      "source": {
        "object": "shop.v_orders_overview",
        "type": "view",
        "key-fields": [
          "id"
        ]
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "orderOverview",
          "plural": "orderOverviews"
        }
      },
      "rest": {
        "enabled": true,
        "path": "/orders-overview"
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    },
    "OrderLine": {
      "source": {
        "object": "shop.v_order_lines",
        "type": "view",
        "key-fields": [
          "id"
        ]
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "orderLine",
          "plural": "orderLines"
        }
      },
      "rest": {
        "enabled": true,
        "path": "/order-lines"
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    },
    "OrderStat": {
      "source": {
        "object": "shop.v_order_stats",
        "type": "view",
        "key-fields": [
          "status"
        ]
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "orderStat",
          "plural": "orderStats"
        }
      },
      "rest": {
        "enabled": true,
        "path": "/order-stats"
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    },
    "Product": {
      "source": {
        "object": "shop.v_products_public",
        "type": "view",
        "key-fields": [
          "id"
        ]
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "product",
          "plural": "products"
        }
      },
      "rest": {
        "enabled": true,
        "path": "/products"
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    },
    "OrderDaily": {
      "source": {
        "object": "shop.v_orders_daily",
        "type": "view",
        "key-fields": [
          "day"
        ]
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "orderDaily",
          "plural": "orderDailies"
        }
      },
      "rest": {
        "enabled": true,
        "path": "/orders-daily"
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    }
  }
}
