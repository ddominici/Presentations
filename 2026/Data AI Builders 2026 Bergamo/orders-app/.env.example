# Copiare in .env per cambiare i default (tutti opzionali; valori di sola demo)
POSTGRES_PASSWORD=postgres
APP_ROLE_PASSWORD=demo_only
PG_PORT=15440

# Embedding: "hash" funziona offline (NON è semantico in senso stretto, vedi README).
# Per un modello reale: EMBEDDING_PROVIDER=openai con un endpoint compatibile
# (OpenAI, Ollama http://host.docker.internal:11434/v1, ...) che accetti dimensions=256.
EMBEDDING_PROVIDER=hash
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
